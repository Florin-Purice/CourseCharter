<UserControl x:Class="WoTMapWPF.CustomControls.MapControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:glwpf="clr-namespace:OpenTK.Wpf;assembly=GLWpfControl"
             xmlns:local="clr-namespace:WoTMapWPF.CustomControls"
             xmlns:cc="clr-namespace:WoTMapWPF"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=local:MapControlViewModel}"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Style="{DynamicResource MapControlStyle}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto" MinWidth="150"/>
        </Grid.ColumnDefinitions>
        <!--GLWpfControl-->
        <ContentControl Grid.Column="0" Grid.ColumnSpan="3" Content="{Binding GLControl}"/>
        <GridSplitter Grid.Column="1" 
                  Style="{DynamicResource VerticalGridSplitterStyle}"
                  Visibility="{Binding Path=Visibility, ElementName=NodesInfoGrid}"/>
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Name="NodesInfoGrid" Visibility="{Binding IsNodesInfoVisible, Converter={StaticResource BoolToVisConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" 
                  Background="{DynamicResource ThemeColorVibrant}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <CheckBox Grid.Column="0"
                          VerticalContentAlignment="Center"
                          Checked="CheckBox_Checked"
                          Unchecked="CheckBox_Unchecked"
                          IsChecked="False"/>
                    <TextBlock Grid.Column="1" 
                           Foreground="{DynamicResource ThemeColorText}"
                           TextTrimming="CharacterEllipsis"
                           FontSize="{DynamicResource FontSizeSmall}"
                           Text="Show only named nodes"
                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                </Grid>
                <ListView Name="PathNodesInfoListView"
                          Grid.Row="1"
                          ItemsSource="{Binding Path.Nodes}"
                          Tag="ShowAll"
                          SelectionChanged="PathNodesInfoListView_SelectionChanged"
                          Loaded="PathNodesInfoListView_Loaded">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem" BasedOn="{StaticResource PathNodeListViewItemStyle}">
                            <EventSetter Event="GotKeyboardFocus" Handler="ListViewItem_GotKeyboardFocus"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <local:CustomTextBox MouseDoubleClick="NameBox_MouseDoubleClick"
                                         Grid.Column="0"
                                         Text="{Binding DisplayName, UpdateSourceTrigger=Explicit}">
                            </local:CustomTextBox>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
            <Button  Grid.Row="1" HorizontalContentAlignment="Stretch"
                     Command="{Binding ToggleNodesInfoVisibilityCommand}">
                <Grid>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="5 0">
                        <TextBlock Text="{cc:DoubleBinding {Binding MapManagerService.ActivePath.TotalDistance},{Binding MapManagerService.MapInfo.DistanceUnitsPerPixel},
                            Converter={StaticResource PixelsToUnitsConverter},
                            StringFormat=N0}"/>
                        <TextBlock Text=" "/>
                        <TextBlock Text="{Binding MapManagerService.MapInfo.UnitLabel}"/>
                    </StackPanel>
                    <Border HorizontalAlignment="Right" ToolTip="Show details">
                        <Image Source="../Res/expand_button.png" Height="20" 
                               Visibility="{Binding IsNodesInfoHidden, Converter={StaticResource BoolToVisConverter}}"/>
                    </Border>
                    <Border HorizontalAlignment="Right" ToolTip="Hide details">
                        <Image Source="../Res/collapse_button.png" Height="20"
                               Visibility="{Binding IsNodesInfoVisible, Converter={StaticResource BoolToVisConverter}}"/>
                    </Border>
                </Grid>
            </Button>
        </Grid>
    </Grid>
</UserControl>
